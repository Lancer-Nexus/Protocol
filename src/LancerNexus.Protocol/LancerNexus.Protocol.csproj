<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>LancerNexus.Protocol</RootNamespace>
    <AssemblyName>LancerNexus.Protocol</AssemblyName>
    <PackageId>LancerNexus.Protocol</PackageId>
    <Description>Versioned wire contracts for Lancer Nexus services and game clients.</Description>
    <PackageReadmeFile>PACKAGE_README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/Lancer-Nexus/Protocol</RepositoryUrl>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;MsgPack017</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MessagePack" Version="3.1.9" />
  </ItemGroup>
  <ItemGroup>
    <None Include="PACKAGE_README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
